{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "betsala/editorial",
  "version": "1.0.0",
  "title": "Текстовый раздел",
  "description": "Контейнер BetSala для обычных Gutenberg-заголовков, абзацев, списков и таблиц. Вставляйте готовый текст целиком.",
  "category": "betsala-blocks",
  "icon": "text",
  "keywords": [
    "betsala",
    "текст",
    "таблица",
    "seo"
  ],
  "attributes": {
    "alternateBackground": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "anchor": true,
    "align": false,
    "html": false
  },
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}
