{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1240px"
    },
    "color": {
      "custom": false,
      "palette": [
        {
          "slug": "betsala-bg",
          "name": "BetSala Background",
          "color": "#0b0d1d"
        },
        {
          "slug": "betsala-surface",
          "name": "BetSala Surface",
          "color": "#151936"
        },
        {
          "slug": "betsala-accent",
          "name": "BetSala Accent",
          "color": "#ff2f68"
        },
        {
          "slug": "betsala-violet",
          "name": "BetSala Violet",
          "color": "#7d4dff"
        },
        {
          "slug": "betsala-text",
          "name": "BetSala Text",
          "color": "#f7f8ff"
        }
      ]
    },
    "typography": {
      "fluid": true
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#0b0d1d",
      "text": "#f7f8ff"
    },
    "typography": {
      "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
    }
  }
}